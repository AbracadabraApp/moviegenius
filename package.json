{
  "name": "moviegenius",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "BUILD_TARGET=mobile next dev",
    "build": "next build",
    "build:mobile": "BUILD_TARGET=mobile next build && npx cap sync ios",
    "build:web": "BUILD_TARGET=web next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ios": "npx cap open ios",
    "ios:run": "npm run build:mobile && npm run ios",
    "batch-scheduler": "node scripts/cron-batch-scheduler.js start",
    "batch-test": "node scripts/scheduled-batch-analysis.js check",
    "batch-create": "node scripts/scheduled-batch-analysis.js run",
    "entity-issue": "node scripts/report-entity-issue.js",
    "content-report": "node scripts/generate-content-coverage-report.js",
    "content-monitor": "node content-coverage-monitor.js",
    "backfill-slugs": "node scripts/backfill-missing-slugs.js",
    "backfill-slugs-test": "node scripts/backfill-missing-slugs.js --limit 5",
    "backfill-slugs-batch": "node scripts/backfill-missing-slugs.js --limit 20",
    "backfill-slugs-resume": "node scripts/backfill-missing-slugs.js --skip 30",
    "backfill-slugs-continue": "node scripts/backfill-missing-slugs.js --limit 25",
    "validate-mediacard": "node scripts/validate-mediacard.js",
    "restore-mediacard": "cp components/MediaCard.js.STABLE components/MediaCard.js && echo 'MediaCard restored to stable version'",
    "setup-person-db": "node scripts/setup-person-database.js",
    "seed-people": "node scripts/seed-person-records.js",
    "seed-people-test": "node scripts/seed-person-records.js --limit 5",
    "test-person-pages": "node scripts/test-person-pages.js",
    "create-batch-tables": "node scripts/create-batch-tables.js",
    "test-batch-endpoints": "node scripts/test-batch-endpoints.js",
    "manual-slug-backfill": "node scripts/manual-slug-backfill.js",
    "check-slug-status": "node scripts/manual-slug-backfill.js --status",
    "update-hero-images": "node scripts/update-hero-images.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.53.0",
    "@capacitor/cli": "^7.3.0",
    "@capacitor/core": "^7.3.0",
    "@capacitor/ios": "^7.3.0",
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "node-cron": "^4.1.0",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.10.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "typescript": "^5.3.0",
    "wrangler": "^4.19.1"
  }
}
