    "title": "The Asphalt Jungle",
    "year": 1950,
    "initialSlug": "Skilled crooks plot one last, fateful jewel heist",
    "initialPoster": "https://image.tmdb.org/t/p/w500/c2SQMd00CCGTiDxGXVqA2J9lmzF.jpg",
