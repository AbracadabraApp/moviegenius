    "title": "Wild Style",
    "year": 1983,
    "initialSlug": "Graffiti artists chase dreams in 1980s NYC streets",
    "initialPoster": "https://image.tmdb.org/t/p/w500/bhlf38aasEZjgdWQOzXwMhaOvGU.jpg",
    "initialStreaming": null,
    "tmdbId": 14243,
