{
  "enabled": true,
  "defaultContext": "movie-analysis",
  "contentTypes": {
    "people": {
      "enabled": true,
      "confidenceThreshold": 0.85,
      "maxLinks": 8,
      "requireProperCapitalization": true,
      "requireFilmContext": [
        "will",
        "may",
        "art",
        "hope",
        "joy"
      ],
      "blacklist": [
        "will",
        "may",
        "young",
        "old",
        "early",
        "late"
      ]
    },
    "movies": {
      "enabled": true,
      "confidenceThreshold": 0.8,
      "maxLinks": 5,
      "requireCapitalizationOrQuotes": true,
      "blacklist": [
        "the",
        "a",
        "an",
        "it",
        "us",
        "her",
        "in",
        "on",
        "up",
        "out"
      ]
    }
  },
  "filtering": {
    "maxLinksPerParagraph": 3,
    "maxLinksPerSentence": 2,
    "requireDatabaseValidation": true,
    "densityLimit": 0.15
  },
  "performance": {
    "enableCaching": true,
    "cacheTimeoutMs": 300000,
    "maxProcessingTimeMs": 3000
  }
}