# Alternative Image Sources Configuration
# Copy this file to .env and add your API keys

# Unsplash API (Free tier: 50 requests/hour)
# Get your key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pexels API (Free tier: 200 requests/hour)  
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# The Movie Database API (You may already have this)
# Get your key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Configure rate limiting and caching
IMAGE_SEARCH_CACHE_TTL=3600
IMAGE_DOWNLOAD_TIMEOUT=30000

# Note: All services offer free tiers sufficient for hero image generation
# Unsplash and Pexels images are free for commercial use with attribution