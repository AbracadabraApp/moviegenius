// Simple movie page test - no PhoneFrame, no navigation
import { useRouter } from 'next/router';

export default function SimpleMoviePage({ title, year, tmdbId, hasAnalysis, sections, error }) {
  const router = useRouter();
  
  if (router.isFallback) {
    return <div>Loading...</div>;
  }

  return (
    <div style={{
      minHeight: '100vh', 
      backgroundColor: '#f3f4f6', 
      padding: '20px'
    }}>
      <div style={{
        maxWidth: '800px', 
        margin: '0 auto', 
        backgroundColor: '#fff', 
        borderRadius: '12px', 
        boxShadow: '0 4px 6px rgba(0,0,0,0.1)', 
        padding: '24px'
      }}>
        
        {/* Debug Info */}
        <div style={{
          backgroundColor: '#000',
          color: '#00ff00',
          padding: '10px',
          borderRadius: '5px',
          fontSize: '12px',
          marginBottom: '20px',
          fontFamily: 'monospace'
        }}>
          <div>🚨 SIMPLE DEBUG v2: Movie {tmdbId}</div>
          <div>Error: {error || 'none'}</div>
          <div>Props: title={title}, year={year}, hasAnalysis={hasAnalysis}</div>
          <div>Sections: {sections?.length || 0}</div>
          <div>Time: {new Date().toLocaleTimeString()}</div>
        </div>

        {/* Movie Title */}
        <h1 style={{
          fontSize: '32px',
          fontWeight: 'bold',
          color: '#000',
          marginBottom: '8px'
        }}>
          {title || 'Unknown Movie'}
        </h1>
        
        {year && (
          <p style={{
            fontSize: '18px',
            color: '#666',
            marginBottom: '24px'
          }}>
            ({year})
          </p>
        )}

        {/* Content */}
        {hasAnalysis && sections?.length > 0 ? (
          <div>
            <h2>Analysis Available</h2>
            <p>Found {sections.length} content sections</p>
            {sections.map((section, index) => (
              <div key={index} style={{
                padding: '16px',
                backgroundColor: '#f8f9fa',
                borderRadius: '8px',
                margin: '8px 0'
              }}>
                <strong>Section {index + 1}:</strong> {section.type}
                <br />
                {section.content?.substring(0, 200)}...
              </div>
            ))}
          </div>
        ) : (
          <div style={{
            padding: '40px',
            textAlign: 'center',
            color: '#666'
          }}>
            <p>Analysis not yet available for this movie.</p>
          </div>
        )}
        
        {error && (
          <div style={{
            backgroundColor: '#fee',
            color: '#c00',
            padding: '16px',
            borderRadius: '8px',
            marginTop: '20px'
          }}>
            <strong>Error:</strong> {error}
          </div>
        )}

      </div>
    </div>
  );
}

// Use same getStaticPaths and getStaticProps as the main movie page
export async function getStaticPaths() {
  console.log('🚀 SIMPLE: Pre-generating single movie path (Star Wars ID 11)');
  
  return {
    paths: [
      { params: { id: '11' } } // Star Wars - pre-generate this path only
    ],
    fallback: 'blocking' // Enable fallback for testing other movie IDs
  };
}

export async function getStaticProps({ params }) {
  const { id } = params;
  
  // Import the same getStaticProps logic from the main movie page
  try {
    const fs = await import('fs');
    const path = await import('path');
    
    // Try to load nuclear static file first
    const nuclearPath = path.default.join(process.cwd(), 'nuclear-static', `movie-${id}.json`);
    
    let movieData = null;
    let hasAnalysis = false;
    let sections = [];
    
    if (fs.default.existsSync(nuclearPath)) {
      const nuclearContent = JSON.parse(fs.default.readFileSync(nuclearPath, 'utf8'));
      movieData = nuclearContent;
      hasAnalysis = true;
      sections = nuclearContent.sections || [];
    }
    
    // Fallback to basic TMDB data
    if (!movieData) {
      // Basic Star Wars data
      movieData = {
        title: id === '11' ? 'Star Wars' : `Movie ${id}`,
        year: id === '11' ? 1977 : null,
        tmdb_id: parseInt(id),
      };
    }

    return {
      props: {
        title: movieData.title,
        year: movieData.year || null,
        tmdbId: parseInt(id),
        hasAnalysis,
        sections,
        error: null
      },
      revalidate: 86400, // Revalidate once per day
    };
    
  } catch (error) {
    console.error('Simple getStaticProps error:', error);
    
    return {
      props: {
        title: `Movie ${id}`,
        year: null,
        tmdbId: parseInt(id),
        hasAnalysis: false,
        sections: [],
        error: error.message
      }
    };
  }
}