# Demo Mode Environment Configuration
# 
# Ultra-aggressive optimizations for small user base demos
# Copy to .env.local or set in deployment environment

# Master demo mode toggle
DEMO_MODE=true

# Static generation optimizations
DEMO_PREGENERATE_ALL=true
DEMO_PREGENERATE_GENIUS=true
DEMO_REVALIDATE_SECONDS=43200
DEMO_BUILD_TIMEOUT=900000

# Ultra-aggressive caching
DEMO_ULTRA_CACHING=true
DEMO_MEDIACARD_TTL=forever
DEMO_PREWARM_POPULAR=true
DEMO_MAX_CACHE_MB=500
DEMO_CACHE_HIT_THRESHOLD=0.9

# Redis cache configuration for demo
REDIS_TTL_MOVIE_DATA=0
REDIS_TTL_STREAMING=0
REDIS_TTL_POSTER=0

# Predictive loading (Phase 3)
DEMO_PREDICTIVE_LOADING=true
DEMO_PREFETCH_COUNT=5
DEMO_BACKGROUND_LIMIT=0.2
DEMO_PREFETCH_MEMORY_MB=100

# Circuit breaker configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_HALF_OPEN_CALLS=3

# Performance monitoring and safety
DEMO_MONITORING=true
DEMO_REGRESSION_THRESHOLD=0.1
DEMO_ERROR_THRESHOLD=0.05
DEMO_MEMORY_THRESHOLD=0.9
DEMO_AUTO_ROLLBACK=true

# Production safety
DEMO_MODE_PRODUCTION=false