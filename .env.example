# MovieGenius Environment Variables Template - RAILWAY EDITION
# Copy this file to .env.local and fill in your actual values

# Anthropic API for Claude integration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Railway PostgreSQL Database (PRIMARY DATABASE)
RAILWAY_DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/dbname

# DEPRECATED - Supabase Database (REMOVE AFTER MIGRATION)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# TMDB Movie Database API
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key-here

# Redis Configuration for High-Performance Caching
REDIS_URL=redis://localhost:6379
# For cloud Redis services:
# REDIS_URL=redis://username:password@host:port
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
CACHE_ENABLED=true

# Optional: Local development
HOST=http://localhost:3000

# Railway Deployment
RAILWAY_ENVIRONMENT_NAME=production