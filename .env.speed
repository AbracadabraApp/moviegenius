# Speed Optimization Configuration for MovieGenius Ask System
# Copy relevant settings to your .env.local file

# Claude Model Selection for Maximum Speed
# SPEED: claude-3-haiku-20240307 (0.5-2s, 5x cheaper)
# BALANCED: claude-3-5-haiku-20241022 (1-3s, 3x cheaper)  
# QUALITY: claude-3-5-sonnet-20241022 (2-8s, current default)
CLAUDE_MODEL_ASK=claude-3-haiku-20240307
CLAUDE_MODEL_EDUCATIONAL=claude-3-5-haiku-20241022
CLAUDE_MODEL_ANALYSIS=claude-3-5-sonnet-20241022

# Predictive Cache Settings
PREDICTIVE_CACHE_ENABLED=true
PREDICTIVE_CACHE_WARM_ON_STARTUP=true
PREDICTIVE_CACHE_TTL=604800  # 7 days

# Follow-up Question Detection
FOLLOW_UP_DETECTION_ENABLED=true
FOLLOW_UP_MAX_LENGTH=50
FOLLOW_UP_KEYWORDS="what about,and,also,more about,tell me about"

# Request Deduplication
REQUEST_DEDUP_ENABLED=true
REQUEST_DEDUP_TTL=30000  # 30 seconds

# Token Limits for Speed
ASK_MAX_TOKENS=1500      # Reduced from 2000 for speed
FOLLOW_UP_MAX_TOKENS=800 # Ultra-fast follow-ups

# Response Time Targets (milliseconds)
TARGET_RESPONSE_TIME_INITIAL=3000   # 3 seconds for first question
TARGET_RESPONSE_TIME_FOLLOWUP=1500  # 1.5 seconds for follow-ups
TARGET_RESPONSE_TIME_CACHED=100     # 100ms for cached responses

# Performance Monitoring
SPEED_MONITORING_ENABLED=true
SPEED_ALERTING_ENABLED=true
SLOW_RESPONSE_THRESHOLD=5000  # Alert if response > 5 seconds