// components/EntityLinkedText.js
import { useState, useEffect } from 'react';
import { entityDetector } from '../lib/entity-linking/EntityDetector';

/**
 * Component that automatically links people and movies in text content
 * Replaces the old underlineProperNames function with enhanced entity linking
 */
export default function EntityLinkedText({ 
  text, 
  linkPeople = true, 
  linkMovies = true,
  context = 'general',
  currentEntity = null,
  className = '',
  style = {},
  fallbackToOld = true
}) {
  const [processedContent, setProcessedContent] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!text || typeof text !== 'string') {
      setProcessedContent(text);
      setIsLoading(false);
      return;
    }

    const processText = async () => {
      try {
        setIsLoading(true);
        setError(null);

        const result = await entityDetector.processText(text, {
          linkPeople,
          linkMovies,
          context,
          currentEntity,
          useCache: true
        });

        if (result.linkedText && result.linkedText !== text) {
          // Successfully processed with new system
          setProcessedContent({
            type: 'html',
            content: result.linkedText,
            stats: result.stats
          });
        } else {
          // No entities found or processing failed
          if (fallbackToOld) {
            // Import the old function as fallback
            try {
              const { underlineProperNames } = await import('../lib/proper-names');
              if (typeof underlineProperNames !== 'function') {
                throw new Error('underlineProperNames is not a function');
              }
              const oldResult = underlineProperNames(text);
              setProcessedContent({
                type: 'react',
                content: oldResult
              });
            } catch (importError) {
              console.error('Failed to import fallback:', importError);
              setProcessedContent({
                type: 'text',
                content: text
              });
            }
          } else {
            setProcessedContent({
              type: 'text',
              content: text
            });
          }
        }
      } catch (err) {
        console.error('EntityLinkedText processing error:', err);
        setError(err);
        
        // Fallback to original text or old system
        if (fallbackToOld) {
          try {
            const { underlineProperNames } = await import('../lib/proper-names');
            if (typeof underlineProperNames !== 'function') {
              throw new Error('underlineProperNames is not a function');
            }
            const oldResult = underlineProperNames(text);
            setProcessedContent({
              type: 'react',
              content: oldResult
            });
          } catch (fallbackErr) {
            console.error('Fallback also failed:', fallbackErr);
            setProcessedContent({
              type: 'text',
              content: text
            });
          }
        } else {
          setProcessedContent({
            type: 'text',
            content: text
          });
        }
      } finally {
        setIsLoading(false);
      }
    };

    processText();
  }, [text, linkPeople, linkMovies, context, currentEntity?.slug, fallbackToOld]);

  // Show loading state
  if (isLoading) {
    return (
      <div className={className} style={style}>
        {text}
      </div>
    );
  }

  // Show error state
  if (error) {
    return (
      <div className={className} style={style}>
        {text}
      </div>
    );
  }

  // Render processed content
  if (!processedContent) {
    return (
      <div className={className} style={style}>
        {text}
      </div>
    );
  }

  if (processedContent.type === 'html') {
    return (
      <div 
        className={className} 
        style={style}
        dangerouslySetInnerHTML={{ __html: processedContent.content }}
      />
    );
  }

  if (processedContent.type === 'react') {
    return (
      <div className={className} style={style}>
        {processedContent.content}
      </div>
    );
  }

  // Plain text fallback
  return (
    <div className={className} style={style}>
      {processedContent.content}
    </div>
  );
}

/**
 * Hook version for more complex use cases
 */
export function useEntityLinkedText(text, options = {}) {
  const [result, setResult] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!text) {
      setResult(text);
      setIsLoading(false);
      return;
    }

    const processText = async () => {
      try {
        setIsLoading(true);
        setError(null);

        const processed = await entityDetector.processText(text, options);
        setResult(processed);
      } catch (err) {
        setError(err);
        setResult({ linkedText: text, entities: { people: [], movies: [] } });
      } finally {
        setIsLoading(false);
      }
    };

    processText();
  }, [text, JSON.stringify(options)]);

  return { result, isLoading, error };
}

/**
 * Simple function replacement for direct migration
 * Can be used as a drop-in replacement for underlineProperNames
 */
export async function processTextWithEntityLinking(text, options = {}) {
  if (!text || typeof text !== 'string') {
    return text;
  }

  try {
    const result = await entityDetector.processTextSimple(text, {
      linkPeople: true,
      linkMovies: true,
      context: 'general',
      ...options
    });
    
    return result;
  } catch (error) {
    console.error('processTextWithEntityLinking error:', error);
    
    // Fallback to old system
    try {
      const { underlineProperNames } = await import('../lib/proper-names');
      return underlineProperNames(text);
    } catch (fallbackError) {
      console.error('Fallback also failed:', fallbackError);
      return text;
    }
  }
}